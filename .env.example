# ── Database ────────────────────────────────────────────────────────────────
# Embedded PostgreSQL (PGlite) data directory — zero-setup local development.
DATABASE_DIR="./.data/pglite"

# Server-mode PostgreSQL connection string — used in production
# (managed Postgres, docker-compose, Supabase, Neon, RDS …).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sevaflow"

# Optional direct (non-pooled) connection used only for `prisma migrate`.
# Neon's pooled host ends in "-pooler"; use the direct endpoint here.
DIRECT_URL=""

# "embedded" (default — runs real PostgreSQL in-process, no server needed)
# "server"   (uses DATABASE_URL above; run `npx prisma migrate deploy` first)
DB_MODE="embedded"

# ── File storage ────────────────────────────────────────────────────────────
# Local directory for uploaded documents in embedded/dev mode.
STORAGE_DIR="./.data/storage"
# "fs" — filesystem under STORAGE_DIR (default in embedded mode)
# "db" — file bytes inside Postgres (default when DB_MODE=server; use on
#        serverless hosts like Vercel which have no persistent filesystem)
STORAGE_BACKEND=""

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-in-production"

# ── AI provider ─────────────────────────────────────────────────────────────
# "demo"    — deterministic, clearly-labelled sample AI output (default)
# "openai"  — uses OPENAI_API_KEY + OPENAI_MODEL
# "gemini"  — uses GEMINI_API_KEY + GEMINI_MODEL
AI_PROVIDER="demo"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
